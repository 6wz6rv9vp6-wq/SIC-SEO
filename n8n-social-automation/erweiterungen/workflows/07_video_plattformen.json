    {
      "id": "077b4037-982e-5f99-b540-6821980b5238",
      "name": "TikTok: Token-Daten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        500
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\n    const STRICT = true;\n    if (!r.access_token) {\n      if (STRICT) throw new Error('TikTok-Token konnte nicht erneuert werden – Workflow 08 (TikTok verbinden) erneut ausführen. ' + JSON.stringify(r).slice(0, 300));\n      return [{ json: { ok: false, access_token: '' } }];\n    }\n    return [{ json: { ok: true, plattform: 'tiktok', access_token: r.access_token, refresh_token: r.refresh_token,\n      open_id: r.open_id || '', scope: r.scope || '', aktualisiert_am: new Date().toISOString() } }];\n"
      }
    },
    {
      "id": "a7caa117-43aa-574f-8107-4223fcdc28d5",
      "name": "TikTok: Token ok?",
