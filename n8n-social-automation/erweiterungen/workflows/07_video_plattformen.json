        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "e0df467a-10ac-5307-86af-3dfd223b3efe",
      "name": "TikTok: Video anhängen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        500
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\n    if (!r.data?.upload_url) throw new Error('TikTok init fehlgeschlagen: ' + JSON.stringify(r.error || r).slice(0, 300));\n    const size = $('TikTok: Upload vorbereiten').first().json.video_size;\n    return [{ json: { publish_id: r.data.publish_id, upload_url: r.data.upload_url, range: `bytes 0-${size - 1}/${size}` },\n      binary: $('Videogröße').first().binary }];\n"
      }
    },
    {
      "id": "be8187d4-9dfa-5227-9fc0-751aa2f271f1",
      "name": "TikTok: Video hochladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        500
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $json.upload_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "video/mp4"
            },
            {
