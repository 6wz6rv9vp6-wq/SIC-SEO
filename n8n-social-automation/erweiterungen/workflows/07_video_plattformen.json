    {
      "id": "32233ede-419e-5463-94df-05e6f051c7b3",
      "name": "TikTok: Creator-Info",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "https://open.tiktokapis.com/v2/post/publish/creator_info/query/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('TikTok: Token-Daten').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "3ab913ee-ab2a-5e04-b356-11ba04e1a519",
      "name": "TikTok: Upload vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        500
      ],
      "parameters": {
        "jsCode": "const c = $('Konfiguration').first().json;\n    const p = $('Videogröße').first().json;\n    const ci = $input.first().json.data || {};\n    const size = p.video_size;\n    const source_info = { source: 'FILE_UPLOAD', video_size: size, chunk_size: size, total_chunk_count: 1 };\n    let url, body;\n    if (c.tiktok_modus === 'direkt') {\n      const opts = ci.privacy_level_options || [];\n      const privacy = opts.includes('PUBLIC_TO_EVERYONE') ? 'PUBLIC_TO_EVERYONE' : (opts.includes('SELF_ONLY') ? 'SELF_ONLY' : opts[0]);\n      if (!privacy) throw new Error('TikTok Creator-Info ohne privacy_level_options: ' + JSON.stringify($input.first().json).slice(0, 300));\n      url = 'https://open.tiktokapis.com/v2/post/publish/video/init/';\n      body = { post_info: { title: String(p.text_tiktok || '').slice(0, 2200), privacy_level: privacy,\n        disable_comment: false, disable_duet: false, disable_stitch: false }, source_info };\n    } else {\n      url = 'https://open.tiktokapis.com/v2/post/publish/inbox/video/init/';\n      body = { source_info };\n    }\n    return [{ json: { init_url: url, init_body: body, video_size: size } }];\n"
      }
    },
    {
      "id": "de43e199-c65d-5fa1-94f1-d230484e6ef7",
      "name": "TikTok: Upload starten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2640,
        500
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.init_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('TikTok: Token-Daten').first().json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
