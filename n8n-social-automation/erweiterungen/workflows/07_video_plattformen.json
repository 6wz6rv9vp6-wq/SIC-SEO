    },
    {
      "id": "c06d0ad9-b12d-5df9-975b-9ceace5ea087",
      "name": "YouTube-Ergebnis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "jsCode": "const y = $('YouTube: Short hochladen').first().json;\n    const id = y.id || '';\n    return [{ json: { post_id: $('Videogröße').first().json.post_id, youtube_video_id: id,\n      meldung: id ? `▶️ YouTube Short hochgeladen: https://youtube.com/shorts/${id}` : `⚠️ YouTube-Upload fehlgeschlagen: ${JSON.stringify(y.error || y).slice(0, 300)}` } }];\n"
      }
    },
