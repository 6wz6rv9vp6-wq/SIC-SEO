    {
      "id": "29ffed63-3e18-59e3-a6e0-0c99fd353bb2",
      "name": "TikTok: Status auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        500
      ],
      "parameters": {
        "jsCode": "// Antwort als Text lesen: TikTok-Video-IDs sind 19-stellig und würden als Zahl gerundet\n    const raw = String($input.first().json.raw || '');\n    const d = JSON.parse(raw).data || {};\n    const idMatch = raw.match(/\"publicaly_available_post_id\"\\s*:\\s*\\[\\s*\"?(\\d+)/);\n    d.publicaly_available_post_id = idMatch ? [idMatch[1]] : [];\n    if (d.status === 'FAILED') throw new Error('TikTok-Upload fehlgeschlagen: ' + (d.fail_reason || JSON.stringify(d)));\n    if ($runIndex > 30) throw new Error('TikTok-Verarbeitung dauert zu lange (Status: ' + d.status + ')');\n    const fertig = ['PUBLISH_COMPLETE', 'SEND_TO_USER_INBOX'].includes(d.status);\n    return [{ json: { fertig, status: d.status, video_id: (d.publicaly_available_post_id || [])[0] || '' } }];\n"
      }
    },
