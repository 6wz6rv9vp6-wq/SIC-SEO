    {
      "id": "9a7423b1-e396-5031-8545-308deb934eef",
      "name": "Post prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json;\n    if (!p || p.format !== 'video' || !p.media_url) throw new Error('Kein Video-Post: ' + JSON.stringify(p).slice(0, 200));\n    return [{ json: p }];\n"
      }
    },
    {
      "id": "4e0e4945-dddd-5657-b06b-a2f6b925437c",
      "name": "Video herunterladen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.media_url }}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "64babfc4-0eba-5d35-b600-977e6d9ed2e2",
      "name": "Videogröße",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n    if (buf.length > 64 * 1024 * 1024) throw new Error('Video größer als 64 MB – bitte kürzer/kleiner erzeugen.');\n    return [{ json: { ...$('Post prüfen').first().json, video_size: buf.length }, binary: $input.first().binary }];\n"
      }
    },
