{
  "name": "07 Video-Plattformen – TikTok & YouTube Shorts",
  "nodes": [
    {
      "id": "0d806df5-9c47-5116-9660-070295bb52cc",
      "name": "Start (von Workflow 03)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
