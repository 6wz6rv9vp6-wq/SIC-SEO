    {
      "id": "5606e8dd-d57d-546a-b784-cde095b1e4de",
      "name": "Claude-Prompt: Post",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const c = $('Konfiguration').first().json;\nconst i = $input.first().json;\nconst kwText = c.keywords[i.keyword] || i.leadmagnet_titel;\nconst system = `Du schreibst Social-Media-Posts für ${c.firma} (${c.ansprechpartner}), ${c.leistung}. Region: ${c.region}.\nZielgruppe: ${c.zielgruppe}. Ansprache: \"${c.ansprache}\". Ton: nahbar, kompetent, klar, ohne Floskeln, sparsame Emojis.\nAufbau Instagram-Caption: starker Hook in Zeile 1 → 3–6 kurze Absätze mit echtem Mehrwert → Call-to-Action:\n\"Kommentiere ${i.keyword} und ich schicke dir ${kwText} kostenlos per DM.\" (max. 2.000 Zeichen, ohne Hashtags).\nFacebook-Text: gleiche Botschaft, etwas ausführlicher, gleicher CTA mit Keyword ${i.keyword}, zusätzlich Hinweis auf Terminbuchung: ${c.termin_link}.\nhashtags: 8–12 passende deutsche Hashtags inkl. regionaler (#braunschweig #göttingen), als ein String.\nbild_prompt: ENGLISCHER Prompt für ein fotorealistisches Bild im Hochformat 4:5, authentisch, keine Schrift/Logos/Zahlen im Bild, keine erkennbaren realen Personen.\nvideo_prompt: ENGLISCHER Prompt für einen 5–10 s Clip im Hochformat 9:16 (B-Roll, ruhige Kamerafahrt), ohne Schrift im Bild.\nalt_text: deutsche Bildbeschreibung (Barrierefreiheit).\nleadmagnet_inhalt: ausführliche Gliederung + Inhalte (Markdown) für den Leadmagneten \"${i.leadmagnet_titel}\" – 6–8 Abschnitte, praxisnah, mit Checklisten. Letzter Abschnitt: Einladung zum kostenlosen Beratungsgespräch (${c.termin_link}).\n\nRechtliche Leitplanken (verbindlich, Werbung für Immobiliar-Verbraucherdarlehen in Deutschland):\\n- Nenne KEINE konkreten Zinssätze, Raten oder Effektivzinsen (sonst Pflichtangaben + repräsentatives Beispiel nach § 17 PAngV nötig).\\n- Keine Heilsversprechen oder Superlative (\\\"garantiert\\\", \\\"beste Konditionen\\\", \\\"immer\\\", \\\"sicher genehmigt\\\").\\n- Keine individuelle Beratung im Post – allgemeine Information, Beratung nur im Gespräch.\\n- Keine falschen Fakten zu Förderprogrammen; wenn unsicher, allgemein bleiben (\\\"aktuelle Förderprogramme prüfen\\\").\\n- Keine Mitbewerber namentlich nennen oder abwerten.`;\nconst user = `Post-Idee:\\nTitel: ${i.titel}\\nHook: ${i.hook}\\nKernaussage: ${i.kernaussage}\\nFormat: ${i.format}\\nLeadmagnet: ${i.leadmagnet_titel} – ${i.leadmagnet_beschreibung}\\nKeyword: ${i.keyword}`;\nreturn [{ json: { idee: i, claude_body: {\n  model: 'claude-opus-5-5',\n  max_tokens: 16000,\n  fallbacks: 'default',\n  output_config: { effort: 'medium', format: { type: 'json_schema', schema: {\"type\": \"object\", \"properties\": {\"caption_instagram\": {\"type\": \"string\"}, \"text_facebook\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"string\"}, \"bild_prompt\": {\"type\": \"string\"}, \"video_prompt\": {\"type\": \"string\"}, \"alt_text\": {\"type\": \"string\"}, \"leadmagnet_inhalt\": {\"type\": \"string\"}}, \"required\": [\"caption_instagram\", \"text_facebook\", \"hashtags\", \"bild_prompt\", \"video_prompt\", \"alt_text\", \"leadmagnet_inhalt\"], \"additionalProperties\": false} } },\n  system,\n  messages: [{ role: 'user', content: user }],\n}}}];\n"
      }
    },
    {
      "id": "19c877fe-047a-5b4f-8677-b999cc70ff46",
      "name": "Claude – Post schreiben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claude_body) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "2e72dc40-a169-56f6-90f2-c82d872c105c",
      "name": "Claude-Antwort parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "// Claude-Antwort lesen: Text-Block(s) einsammeln und als JSON parsen\nconst r = $input.first().json;\nif (r.stop_reason === 'refusal') {\n  throw new Error('Claude hat die Anfrage abgelehnt: ' + JSON.stringify(r.stop_details || {}));\n}\nif (r.stop_reason === 'max_tokens') {\n  throw new Error('Claude-Antwort abgeschnitten (max_tokens) – max_tokens im Prompt-Node erhöhen.');\n}\nconst text = (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('');\nreturn [{ json: JSON.parse(text) }];\n"
      }
    },
    {
      "id": "639823f5-b88d-55f1-a762-d01928a17786",
      "name": "Post-Daten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "const p = $input.first().json;\nconst i = $('Claude-Prompt: Post').first().json.idee;\nconst c = $('Konfiguration').first().json;\nconst post_id = 'P' + new Date().toISOString().replace(/[-:T]/g, '').slice(0, 14);\nconst gamma = {\n  inputText: `# ${i.leadmagnet_titel}\\n\\n${p.leadmagnet_inhalt}`,\n  textMode: 'generate',\n  format: 'document',\n  numCards: 8,\n  exportAs: 'pdf',\n  additionalInstructions: `Leadmagnet von ${c.firma}. Seriös, hell, modern. Kontakt & Termin am Ende: ${c.termin_link}. Keine konkreten Zinssätze.`,\n  textOptions: { amount: 'medium', tone: 'kompetent, freundlich, verständlich', audience: c.zielgruppe, language: 'de' },\n  imageOptions: { source: 'aiGenerated' },\n  sharingOptions: { externalAccess: 'view' },\n};\nif (c.gamma_theme_id) gamma.themeId = c.gamma_theme_id;\nreturn [{ json: { ...p, post_id, idee_id: i.idee_id, format: i.format, keyword: i.keyword, leadmagnet_titel: i.leadmagnet_titel, gamma_body: gamma } }];\n"
      }
    },
