        "jsCode": "const p = $('Post-Zeile bauen').first().json;\nconst e = s => String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet t = `📝 <b>Freigabe: ${e(p.post_id)}</b> (${e(p.format)})\\n\\n<b>Instagram</b>\\n${e(p.caption_instagram)}\\n\\n<b>Facebook</b>\\n${e(p.text_facebook)}`;\nt = t.slice(0, 3500);\nt += `\\n\\n🎁 Leadmagnet: <a href=\"${e(p.gamma_url)}\">${e(p.leadmagnet_titel)}</a>\\n🔑 Keyword: <b>${e(p.keyword)}</b>`;\nreturn [{ json: { text: t, post_id: p.post_id } }];\n"
      }
