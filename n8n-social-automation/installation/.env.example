# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Subdomain, deren DNS-A-Record auf die Server-IP zeigt
N8N_DOMAIN=n8n.deine-domain.de
# Zufallswerte erzeugen mit:  openssl rand -hex 32
POSTGRES_PASSWORD=
# WICHTIG: sicher aufbewahren – ohne diesen Schlüssel sind gespeicherte Zugangsdaten nach einer Wiederherstellung unbrauchbar
N8N_ENCRYPTION_KEY=
# optional feste Version, z. B. 1.120.0 (Standard: stable)
N8N_VERSION=stable
